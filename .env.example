# Copie ce fichier en .env.local (dev) et renseigne les 2 valeurs.
# Sur Vercel : Settings > Environment Variables, ajoute les 2 mêmes clés.
# La clé est publique par conception (protégée par les policies RLS de Supabase) :
# soit l'ancienne "anon" (eyJhbGciOi...), soit la nouvelle "publishable" (sb_publishable_...).

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
